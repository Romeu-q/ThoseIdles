<UserControl x:Class="ThoseIdles.Views.AccountPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ThoseIdles.ViewModels"
             xmlns:local="clr-namespace:ThoseIdles.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AccountViewModel}"
             SizeChanged="OnSizeChanged">
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
        <DockPanel>
            <!-- Cabeçalho -->
            <Grid DockPanel.Dock="Top" Height="32" Background="{StaticResource HeaderBg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="9" Height="9" Margin="9,0,7,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}"
                         ToolTip="{Binding StatusDetail}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Text}" FontWeight="Normal" FontSize="12.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180"
                               Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                               ToolTip="{Binding ProfileName, StringFormat=Perfil isolado: {0}}" />
                    <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Width="150" FontSize="12"
                             MaxLength="40" VerticalAlignment="Center"
                             Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVis}}"
                             IsVisibleChanged="OnNameBoxVisibleChanged" LostKeyboardFocus="OnNameBoxLostFocus">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="8,0,0,0"
                               VerticalAlignment="Center" ToolTip="{Binding StatusDetail}" />
                </StackPanel>

                <!-- Memória (discreta) -->
                <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="4,0,6,0"
                           Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                           ToolTip="Quanta memória (RAM) esta conta está usando." />

                <!-- Poucos botões, com texto; o resto fica no menu "Mais" -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,4,0"
                            Visibility="{Binding IsConfirmingClear, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <!-- Selo do modo econômico (só aparece quando ligado) -->
                    <Border Background="#1F3A2A" CornerRadius="3" Padding="8,1" Margin="0,0,6,0" VerticalAlignment="Center"
                            Visibility="{Binding IsEconomy, Converter={StaticResource BoolToVis}}" ToolTip="{Binding EconomyTooltip}">
                        <TextBlock Text="Modo econômico" Foreground="{StaticResource Good}" FontSize="11" FontWeight="Normal" />
                    </Border>
                    <!-- Lives da Twitch desta conta -->
                    <Button Command="{Binding ToggleLiveCommand}" ToolTip="{Binding LiveToggleTooltip}"
                            Visibility="{Binding HasLiveChannel, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="MinWidth" Value="26" />
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel Orientation="Horizontal" Margin="4,0">
                                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LiveCountText, StringFormat={}{0} live(s)}" FontFamily="{StaticResource PixelFont}" FontSize="11" FontWeight="Normal"
                                                       Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" Value="0.55" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLiveOpen}" Value="True">
                                        <Setter Property="Foreground" Value="#A970FF" />
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ReloadCommand}" ToolTip="Recarregar o jogo nesta conta (resolve a maioria dos travamentos)"
                            Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel Orientation="Horizontal" Margin="6,0">
                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" />
                                            <TextBlock Text="Recarregar" FontFamily="{StaticResource PixelFont}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding FocusCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE740;" />
                                <Setter Property="ToolTip" Value="Deixar esta conta grande (as outras continuam rodando)" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                        <Setter Property="Content" Value="&#xE73F;" />
                                        <Setter Property="ToolTip" Value="Voltar a ver todas as contas" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Confirmação de limpeza (inline: nada de janela externa) -->
                <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Background="{StaticResource BannerBg}"
                            Visibility="{Binding IsConfirmingClear, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Apagar login, cookies e dados SÓ desta conta?" Foreground="{StaticResource Text}" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0" />
                    <Button Style="{StaticResource DangerButton}" Content="Apagar" Command="{Binding ConfirmClearCommand}" Padding="8,1" />
                    <Button Style="{StaticResource BarButton}" Content="Cancelar" Command="{Binding CancelClearCommand}" Padding="8,1" />
                </StackPanel>
            </Grid>

            <!-- TODAS as ações da conta à mostra (antes ficavam escondidas no menu "Mais"); quebram de linha se o painel é estreito -->
            <Border DockPanel.Dock="Top" Background="#1A1A20" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="6,3,6,3"
                    Visibility="{Binding IsCompact, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                            <Setter Property="MinHeight" Value="24" />
                            <Setter Property="Padding" Value="8,1" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="FontSize" Value="11.5" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button Command="{Binding ToggleOpenCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                <Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="8,1" /><Setter Property="Margin" Value="2" /><Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Content" Value="⏻ Fechar esta conta" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="False"><Setter Property="Content" Value="▶ Abrir esta conta" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="↻ Reiniciar esta conta" Command="{Binding RestartCommand}" ToolTip="Fecha e abre de novo só esta conta." />
                    <Button Command="{Binding ToggleEconomyCommand}" ToolTip="Fecha a página do jogo e deixa a conta conectada com quase nada de RAM; dá para jogar pela tela mínima.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                <Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="8,1" /><Setter Property="Margin" Value="2" /><Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Content" Value="Modo econômico" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEconomy}" Value="True">
                                        <Setter Property="Content" Value="✓ Modo econômico (ligado)" />
                                        <Setter Property="Background" Value="#1F3A2A" /><Setter Property="Foreground" Value="{StaticResource Good}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ToggleHuntCommand}" Visibility="{Binding ShowHuntToggle, Converter={StaticResource BoolToVis}}" ToolTip="A extensão /hunt (guia de hunts) nesta conta.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                <Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="8,1" /><Setter Property="Margin" Value="2" /><Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Content" Value="Extensão /hunt" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HuntEnabled}" Value="True">
                                        <Setter Property="Content" Value="✓ Extensão /hunt (ligada)" />
                                        <Setter Property="Background" Value="#2C2547" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Width="1" Height="18" Background="{StaticResource Border}" Margin="5,0" />
                    <Button Content="− Zoom" Command="{Binding ZoomOutCommand}" ToolTip="Diminuir o zoom desta conta" />
                    <Button Content="+ Zoom" Command="{Binding ZoomInCommand}" ToolTip="Aumentar o zoom desta conta" />
                    <Button Content="Zoom 100%" Command="{Binding ResetZoomCommand}" ToolTip="Voltar o zoom ao normal" />
                    <Border Width="1" Height="18" Background="{StaticResource Border}" Margin="5,0" />
                    <Button Content="✎ Mudar o nome" Command="{Binding BeginRenameCommand}" />
                    <Button Content="🛠 Ferramentas de desenvolvedor" Command="{Binding DevToolsCommand}" />
                    <Button Content="⎋ Sair desta conta (apaga o login)" Command="{Binding RequestClearCommand}" Background="#3A1A1E" Foreground="#FF8A8D"
                            ToolTip="Apaga o login, os cookies e os dados SÓ desta conta (pede confirmação)." />
                </WrapPanel>
            </Border>
            <!-- Faixa de estado (erro/offline/fechada). Fica ACIMA da página: o WebView2 é um HWND e
                 nada do WPF consegue ser desenhado por cima dele. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BannerBg}" Padding="10,5"
                    Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ReloadCommand}" Padding="8,1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                                <Setter Property="Content" Value="Tentar agora" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                        <Setter Property="Content" Value="Abrir conta" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Text}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- O jogo e, abaixo, a live da Twitch desta conta (divisória arrastável entre os dois) -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding GameRowHeight, Mode=TwoWay}" MinHeight="60" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding LiveRowHeight, Mode=TwoWay}" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <!-- Conta fechada: um botão grande e óbvio -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="Esta conta está fechada" FontSize="15" FontWeight="Normal" Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
                        <TextBlock Text="Clique no botão para entrar no jogo com ela." FontSize="12" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,12" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleOpenCommand}" HorizontalAlignment="Center" Padding="22,8" FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Abrir esta conta" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- Modo econômico: a página do jogo está fechada, mas a conta segue conectada -->
                    <!-- A versão mínima do jogo: caçar, time, Depot, Centro, bolas e registro (sem a página do jogo) -->
                    <local:EconomyGameView Visibility="{Binding ShowEconomyNotice, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Visibility="Collapsed" Text="{Binding StatusDetail}" />
                    <ContentPresenter Content="{Binding Session.WebView}" />
                </Grid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="#2C2C35" Cursor="SizeNS" ToolTip="Arraste para dividir o espaço entre o jogo e a live"
                              Visibility="{Binding ShowLiveSplitter, Converter={StaticResource BoolToVis}}" />

                <DockPanel Grid.Row="2" Visibility="{Binding ShowLive, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Height="24" Background="#1A1524">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center" Margin="6,0" ClipToBounds="True">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE714;" FontFamily="{StaticResource Icons}" Foreground="#A970FF" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LiveMemoryText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                       ToolTip="Memória de todas as lives desta conta (privada em RAM)." />
                            <!-- Uma aba por live: clique mostra, × fecha e esquece o canal -->
                            <ItemsControl ItemsSource="{Binding Session.Lives}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="tab" CornerRadius="3" Margin="0,0,3,0" Padding="6,0,2,0" Background="#24202E">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Conferência da live (Twitch): verde = logada e com chat; vermelha = o bônus não está contando -->
                                                <Ellipse x:Name="saude" Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Fill="Transparent"
                                                         ToolTip="{Binding Status}" />
                                                <Button Content="{Binding DisplayName}" FontSize="11" Cursor="Hand" Focusable="False" Background="Transparent"
                                                        BorderThickness="0" Foreground="{StaticResource Text}" Padding="0" ToolTip="{Binding Status}"
                                                        Command="{Binding DataContext.SelectLiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="8" Width="16" Height="18"
                                                        ToolTip="Fechar esta live e esquecer o canal"
                                                        Command="{Binding DataContext.CloseLiveTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="tab" Property="Background" Value="#4A3570" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Healthy}" Value="True">
                                                <Setter TargetName="saude" Property="Fill" Value="#3FC46E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Healthy}" Value="False">
                                                <Setter TargetName="saude" Property="Fill" Value="#E5484D" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,3,0">
                            <Button Command="{Binding ToggleLiveMuteCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Content" Value="&#xE767;" />
                                        <Setter Property="ToolTip" Value="Silenciar a live" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LiveMuted}" Value="True">
                                                <Setter Property="Content" Value="&#xE74F;" />
                                                <Setter Property="ToolTip" Value="Live muda (clique para ouvir)" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Command="{Binding OpenLiveExternallyCommand}" ToolTip="Abrir este canal no navegador padrão" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE73F;" Command="{Binding HideLiveCommand}" ToolTip="Esconder o painel (as lives continuam abertas em segundo plano; o 📺 do cabeçalho mostra de novo)" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding CloseLiveCommand}" ToolTip="Fechar TODAS as lives desta conta e esquecer os canais" />
                        </StackPanel>
                    </Grid>
                    <!-- Todas as lives ficam aqui (na árvore visual, rodando); só a escolhida aparece. -->
                    <ItemsControl ItemsSource="{Binding Session.Lives}" SizeChanged="OnLiveSizeChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding View}" Visibility="{Binding IsShown, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
