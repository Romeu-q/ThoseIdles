<UserControl x:Class="ThoseIdles.Views.EconomyGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Abas (uma só marcada por vez: os RadioButtons dividem o mesmo painel pai) -->
        <Style x:Key="AbaBt" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="12,4" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Mini" TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="Linha" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Mudo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Rolagem" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnTamanho">
    <Grid x:Name="Raiz" Margin="10,8,10,8" MinHeight="440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Treinador: nick, nível, barra de XP e moedas -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Ouro" Text="🪙 —" FontSize="12" Margin="0,0,10,0" ToolTip="Ouro" />
                <TextBlock x:Name="Diamantes" Text="💎 —" FontSize="12" Margin="0,0,10,0" ToolTip="Diamantes" />
                <TextBlock x:Name="Gemas" Text="◆ —" FontSize="12" Foreground="#F26DB0" ToolTip="Gemas" />
            </StackPanel>
            <TextBlock x:Name="Nick" Text="—" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="Nivel" Text="" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,5,0,0" Height="14">
            <ProgressBar x:Name="BarraXp" Minimum="0" Maximum="1" Value="0" Foreground="#4C8DFF" Background="{StaticResource CardBg}" BorderThickness="0" />
            <TextBlock x:Name="TextoXp" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
        </Grid>

        <!-- O que está acontecendo -->
        <Border Grid.Row="2" Style="{StaticResource Linha}" Margin="0,6,0,6" Padding="10,4">
            <StackPanel>
                <TextBlock x:Name="Situacao" Text="Conectando…" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Detalhe" Style="{StaticResource Mudo}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock x:Name="Aviso" FontSize="11.5" Foreground="#F0B429" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Abas -->
        <DockPanel x:Name="BarraAbas" Grid.Row="3" Margin="0,0,0,6">
            <!-- Centro Pokémon e combate -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtCentro" Style="{StaticResource Mini}" Content="🏥 Centro" Click="OnCentro"
                        ToolTip="Sai da hunt e volta ao Centro Pokémon (a conta para de caçar). No Safari o jogo pede confirmação, então use o jogo completo." />
                <Button Style="{StaticResource Mini}" Content="💊 Curar" Click="OnCurar" ToolTip="Cura o time. Só funciona dentro do Centro Pokémon." />
                <Button Style="{StaticResource Mini}" Content="✋ Desistir" Click="OnDesistir" ToolTip="Desiste da luta atual (pede confirmação)." />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
            <RadioButton x:Name="AbaCacar" Style="{StaticResource AbaBt}" Content="Caçar" IsChecked="True" Checked="OnAba" />
            <RadioButton x:Name="AbaTime" Style="{StaticResource AbaBt}" Content="Time" Checked="OnAba" />
            <RadioButton x:Name="AbaDepot" Style="{StaticResource AbaBt}" Content="Depot" Checked="OnAba" />
            <RadioButton x:Name="AbaMarket" Style="{StaticResource AbaBt}" Content="Market" Checked="OnAba" />
            <RadioButton x:Name="AbaBolas" Style="{StaticResource AbaBt}" Content="Bolas e automação" Checked="OnAba" />
            <RadioButton x:Name="AbaRegistro" Style="{StaticResource AbaBt}" Content="Registro" Checked="OnAba" />
            </WrapPanel>
        </DockPanel>

        <Grid Grid.Row="4">
            <!-- Caçar -->
            <DockPanel x:Name="PainelCacar">

                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBox x:Name="Filtro" Padding="6,4" FontSize="12" Background="{StaticResource CardBg}" Foreground="{StaticResource Text}"
                             BorderBrush="{StaticResource Border}" CaretBrush="{StaticResource Text}" TextChanged="OnFiltro" />
                    <TextBlock Text="🔎 Buscar hunt ou região…" IsHitTestVisible="False" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Filtro}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <!-- A melhor hunt de XP agora, para o Pokémon em campo (a conta do PokéIdle Hub) -->
                    <Border x:Name="CartaoMelhores" Style="{StaticResource Linha}" BorderBrush="#F0B429" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="↻ Recalcular" Click="OnRecalcular"
                                        ToolTip="Recalcula agora (leva alguns segundos; o app abre o Hub escondido, sem login)." />
                                <TextBlock Text="🏆 MELHORES HUNTS DE XP AGORA" FontSize="11" FontWeight="SemiBold" Foreground="#F0B429" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="MelhoresInfo" Style="{StaticResource Mudo}" TextWrapping="Wrap" Margin="0,3,0,4" />
                            <ItemsControl x:Name="ListaMelhores">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="{Binding Botao}" Tag="{Binding Slug}" IsEnabled="{Binding PodeCacar}" Click="OnCacar" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Mudo}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="ListaHunts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Linha}" BorderBrush="{Binding Borda}" Opacity="{Binding Opacidade}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="{Binding Botao}" Tag="{Binding Slug}"
                                                IsEnabled="{Binding PodeCacar}" Click="OnCacar" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Mudo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Time -->
            <DockPanel x:Name="PainelTime" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="Toque em “Em campo” para trocar o Pokémon que luta. “Tirar” manda para o Depot." Style="{StaticResource Mudo}" Margin="0,0,0,6" TextWrapping="Wrap" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListaTime">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Linha}" BorderBrush="{Binding Borda}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="Tirar" Tag="{Binding Id}" Click="OnTirarDoTime"
                                                ToolTip="Manda este Pokémon para o Depot (o jogo recusa se for o único que pode lutar)." />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="{Binding Botao}" Tag="{Binding Id}"
                                                IsEnabled="{Binding PodeColocar}" Click="OnAtivo" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Mudo}" />
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding HpFrac, Mode=OneWay}" Height="4" Margin="0,4,0,0"
                                                         Foreground="{Binding HpCor}" Background="#2A2A33" BorderThickness="0" Visibility="{Binding HpVisivel}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Depot: os Pokémon guardados -->
            <DockPanel x:Name="PainelDepot" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="›" Click="OnDepotProxima" ToolTip="Próxima página" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="‹" Click="OnDepotAnterior" ToolTip="Página anterior" />
                    <TextBlock x:Name="DepotPagina" DockPanel.Dock="Right" Style="{StaticResource Mudo}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Grid>
                        <TextBox x:Name="FiltroDepot" Padding="6,4" FontSize="12" Background="{StaticResource CardBg}" Foreground="{StaticResource Text}"
                                 BorderBrush="{StaticResource Border}" CaretBrush="{StaticResource Text}" TextChanged="OnFiltroDepot" />
                        <TextBlock Text="🔎 Buscar no Depot…" IsHitTestVisible="False" Foreground="{StaticResource Muted}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FiltroDepot}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Mudo}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Shinies primeiro, depois do maior nível. “Vender” sempre pergunta antes. Quem está na Coleção (🔒) fica protegido." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListaDepot">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Linha}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="Vender" Tag="{Binding Id}" Click="OnVender"
                                                IsEnabled="{Binding PodeVender}" ToolTip="{Binding DicaVender}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="{Binding BotaoColecao}" Tag="{Binding Id}" Click="OnColecao"
                                                ToolTip="Coleção: protege o Pokémon da venda e das automações." />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="→ Time" Tag="{Binding Id}" Click="OnParaTime" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Mudo}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Market (loja NPC de ouro: pokébolas, poções, revives e ovos — sem RMT e sem loja de diamantes) -->
            <ScrollViewer x:Name="PainelMarket" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Linha}" BorderBrush="#3FC46E" Margin="0,0,0,8">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtRegraBolasMarket" Style="{StaticResource Mini}" Content="⚪ &lt; 100 → +500" Click="OnCiclarRegraBolas"
                                            ToolTip="Clique para mudar o estoque mínimo e o lote de reposição das Pokébolas." />
                                    <Button x:Name="BtRegraItensMarket" Style="{StaticResource Mini}" Content="💊 &lt; 30 → +100" Click="OnCiclarRegraItens"
                                            ToolTip="Clique para mudar o estoque mínimo e o lote de reposição de Poções e Revives." />
                                </StackPanel>
                                <TextBlock Text="🔄 COMPRA AUTOMÁTICA (QUANDO ESTIVER ACABANDO)" FontSize="11" FontWeight="SemiBold" Foreground="#3FC46E" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,5,0,3">
                                <CheckBox x:Name="AutoCompraBolasMarket" Content="Repor Pokébolas" Margin="0,0,14,0" Click="OnAutoCompraCategoria" />
                                <CheckBox x:Name="AutoCompraPocoesMarket" Content="Repor Poções" Margin="0,0,14,0" Click="OnAutoCompraCategoria" />
                                <CheckBox x:Name="AutoCompraRevivesMarket" Content="Repor Revives" Click="OnAutoCompraCategoria" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Mudo}" TextWrapping="Wrap"
                                       Text="Repõe sozinho (em ouro, sem pedir confirmação) os itens com “✓ Auto” abaixo ou marcados na aba Bolas e automação quando o estoque cair abaixo do mínimo." />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="⚪ POKÉBOLAS" Style="{StaticResource Mudo}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl x:Name="ListaMarketBolas">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Linha}" BorderBrush="{Binding AutoBorda}" Opacity="{Binding Opacidade}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+1.000" Tag="{Binding Id}" IsEnabled="{Binding PodeComprar}" Click="OnComprar1000" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+100" Tag="{Binding Id}" IsEnabled="{Binding PodeComprar}" Click="OnComprar100" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+10" Tag="{Binding Id}" IsEnabled="{Binding PodeComprar}" Click="OnComprar10" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="{Binding AutoTexto}" BorderBrush="{Binding AutoBorda}" Tag="{Binding Id}" Visibility="{Binding AutoVisivel}"
                                                IsEnabled="{Binding PodeComprar}" Click="OnAlternarAutoBola" ToolTip="Liga ou desliga a compra automática desta bola quando estiver acabando." />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Mudo}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="🧪 POÇÕES" Style="{StaticResource Mudo}" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <ItemsControl x:Name="ListaMarketPocoes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Linha}" BorderBrush="{Binding AutoBorda}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+1.000" Tag="{Binding Id}" Click="OnComprarItem1000" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+100" Tag="{Binding Id}" Click="OnComprarItem100" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+10" Tag="{Binding Id}" Click="OnComprarItem10" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="{Binding AutoTexto}" BorderBrush="{Binding AutoBorda}" Tag="{Binding Id}" Visibility="{Binding AutoVisivel}"
                                                Click="OnAlternarAutoItem" ToolTip="Liga ou desliga a compra automática desta poção quando estiver acabando." />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Mudo}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="💊 REVIVES" Style="{StaticResource Mudo}" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <ItemsControl x:Name="ListaMarketRevives">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Linha}" BorderBrush="{Binding AutoBorda}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+1.000" Tag="{Binding Id}" Click="OnComprarItem1000" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+100" Tag="{Binding Id}" Click="OnComprarItem100" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+10" Tag="{Binding Id}" Click="OnComprarItem10" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="{Binding AutoTexto}" BorderBrush="{Binding AutoBorda}" Tag="{Binding Id}" Visibility="{Binding AutoVisivel}"
                                                Click="OnAlternarAutoItem" ToolTip="Liga ou desliga a compra automática deste revive quando estiver acabando." />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Mudo}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="🥚 OVOS MISTERIOSOS (NPC)" Style="{StaticResource Mudo}" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <ItemsControl x:Name="ListaMarketOvos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Linha}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+1" Tag="{Binding Id}" Click="OnComprarItem1" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detalhe}" Style="{StaticResource Mudo}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Bolas e automação -->
            <ScrollViewer x:Name="PainelBolas" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="AutoNota" Style="{StaticResource Mudo}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <CheckBox x:Name="AutoAteCapturar" Content="Lançar bola até capturar (VIP)" Click="OnAutoBola" />
                    <CheckBox x:Name="AutoSemParar" Content="Lançar bola sem parar (VIP)" Click="OnAutoBola" />
                    <CheckBox x:Name="AutoRevive" Content="Reviver sozinho" Click="OnAutoSimples" />
                    <CheckBox x:Name="AutoPotion" Content="Usar poção sozinho" Click="OnAutoSimples" />
                    <CheckBox x:Name="AutoVoltar" Content="Voltar para a hunt depois de curar" Click="OnAutoSimples" />
                    <Border Style="{StaticResource Linha}" BorderBrush="#3FC46E" Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtRegraBolas" Style="{StaticResource Mini}" Content="⚪ &lt; 100 → +500" Click="OnCiclarRegraBolas"
                                            ToolTip="Clique para mudar o estoque mínimo e o lote de reposição das Pokébolas." />
                                    <Button x:Name="BtRegraItens" Style="{StaticResource Mini}" Content="💊 &lt; 30 → +100" Click="OnCiclarRegraItens"
                                            ToolTip="Clique para mudar o estoque mínimo e o lote de reposição de Poções e Revives." />
                                </StackPanel>
                                <TextBlock Text="🔄 COMPRAR AUTOMÁTICO QUANDO ESTIVER ACABANDO" FontSize="11" FontWeight="SemiBold" Foreground="#3FC46E" VerticalAlignment="Center" />
                            </DockPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <CheckBox x:Name="AutoCompraBolas" Content="Repor Pokébolas marcadas" Margin="0,0,14,0" Click="OnAutoCompraCategoria" />
                                <CheckBox x:Name="AutoCompraPocoes" Content="Repor Poções marcadas" Margin="0,0,14,0" Click="OnAutoCompraCategoria" />
                                <CheckBox x:Name="AutoCompraRevives" Content="Repor Revives marcados" Click="OnAutoCompraCategoria" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="BOLAS USADAS PELA AUTOMAÇÃO (toque para ligar/desligar)" Style="{StaticResource Mudo}" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <ItemsControl x:Name="ListaBolas">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+1.000" Tag="{Binding Id}" Click="OnComprar1000"
                                            ToolTip="Comprar 1.000 desta bola na loja (pede confirmação)." />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+100" Tag="{Binding Id}" Click="OnComprar100"
                                            ToolTip="Comprar 100 desta bola na loja (pede confirmação)." />
                                    <Button Style="{StaticResource BarButton}" HorizontalContentAlignment="Stretch" Margin="0" BorderBrush="{Binding Borda}"
                                            Tag="{Binding Id}" Click="OnBola" ToolTip="Liga ou desliga esta bola na automação.">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Quantidade}" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding Titulo}" />
                                        </DockPanel>
                                    </Button>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="POÇÕES USADAS PELA AUTOMAÇÃO (toque para ligar/desligar)" Style="{StaticResource Mudo}" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <ItemsControl x:Name="ListaAutoPocoes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+1.000" Tag="{Binding Id}" Click="OnComprarItem1000"
                                            ToolTip="Comprar 1.000 desta poção na loja (pede confirmação)." />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+100" Tag="{Binding Id}" Click="OnComprarItem100"
                                            ToolTip="Comprar 100 desta poção na loja (pede confirmação)." />
                                    <Button Style="{StaticResource BarButton}" HorizontalContentAlignment="Stretch" Margin="0" BorderBrush="{Binding Borda}"
                                            Tag="{Binding Id}" Click="OnPocaoAuto" ToolTip="Liga ou desliga esta poção na automação.">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Quantidade}" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding Titulo}" />
                                        </DockPanel>
                                    </Button>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="REVIVES USADOS PELA AUTOMAÇÃO (toque para ligar/desligar)" Style="{StaticResource Mudo}" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <ItemsControl x:Name="ListaAutoRevives">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+1.000" Tag="{Binding Id}" Click="OnComprarItem1000"
                                            ToolTip="Comprar 1.000 deste revive na loja (pede confirmação)." />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Mini}" Content="+100" Tag="{Binding Id}" Click="OnComprarItem100"
                                            ToolTip="Comprar 100 deste revive na loja (pede confirmação)." />
                                    <Button Style="{StaticResource BarButton}" HorizontalContentAlignment="Stretch" Margin="0" BorderBrush="{Binding Borda}"
                                            Tag="{Binding Id}" Click="OnReviveAuto" ToolTip="Liga ou desliga este revive na automação.">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Quantidade}" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding Titulo}" />
                                        </DockPanel>
                                    </Button>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Registro -->
            <ScrollViewer x:Name="PainelRegistro" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TextoRegistro" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="17" />
            </ScrollViewer>
        </Grid>

        <!-- Rodapé -->
        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Abrir o jogo completo" Command="{Binding ToggleEconomyCommand}"
                    ToolTip="Sai do modo econômico e abre a página do jogo desta conta." />
            <TextBlock x:Name="Rodape" Style="{StaticResource Mudo}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
