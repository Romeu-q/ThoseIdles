<UserControl x:Class="ThoseIdles.Views.SummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Cartão de número grande -->
        <Style x:Key="CartaoNum" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="Grande" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Legenda" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Secao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Cel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <!-- Cabeçalho clicável (ordena) -->
        <Style x:Key="Cabecalho" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="0,6,12,6">
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Linha clicável (abre a conta) -->
        <Style x:Key="LinhaBt" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,9">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Cartão de uma conta (clicável: abre a conta) -->
        <Style x:Key="CartaoBt" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="8" Padding="16,12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A4A58" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Linha de aviso (clicável: abre a conta) -->
        <Style x:Key="AvisoBt" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Barra fina (progresso do nível) -->
        <Style x:Key="Barra" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#2C2C35" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14,18,18">
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" x:Name="Atualizado" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" />
                <TextBlock Text="RESUMO DAS CONTAS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- O que precisa de atenção agora (ou "tudo certo") -->
            <Border x:Name="CartaoAvisos" Background="#241E14" BorderBrush="#6B5320" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secao}" Foreground="#F0B429" Text="⚠ PRECISA DE ATENÇÃO · CLIQUE PARA ABRIR A CONTA" Margin="6,0,0,4" />
                    <ItemsControl x:Name="Avisos">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AvisoBt}" Tag="{Binding Slot}" Click="OnOpenAccount">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" Fill="{Binding Cor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Conta}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Texto}" Foreground="{Binding TextoCor}" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border x:Name="CartaoTudoCerto" Background="#14231A" BorderBrush="#24583A" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,0,0,14">
                <TextBlock x:Name="TudoCerto" Foreground="{StaticResource Good}" FontSize="12.5" FontWeight="SemiBold" />
            </Border>

            <!-- Por conta -->
            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12,16,6" Margin="0,0,0,14">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Style="{StaticResource Secao}" Text="POR CONTA · CLIQUE NO CABEÇALHO PARA ORDENAR, NA LINHA PARA ABRIR A CONTA" />
                    <Grid x:Name="Cabecalhos">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="c0" /><ColumnDefinition SharedSizeGroup="c1" /><ColumnDefinition SharedSizeGroup="c2" />
                            <ColumnDefinition SharedSizeGroup="c3" /><ColumnDefinition SharedSizeGroup="c4" /><ColumnDefinition SharedSizeGroup="c5" />
                            <ColumnDefinition SharedSizeGroup="c6" /><ColumnDefinition SharedSizeGroup="c7" /><ColumnDefinition SharedSizeGroup="c8" />
                            <ColumnDefinition SharedSizeGroup="c9" /><ColumnDefinition SharedSizeGroup="c10" /><ColumnDefinition Width="*" MinWidth="150" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource Cabecalho}" Tag="conta" Click="OnSort" Content="CONTA" />
                        <Button Grid.Column="1" Style="{StaticResource Cabecalho}" Tag="hunt" Click="OnSort" Content="HUNT" />
                        <Button Grid.Column="2" Style="{StaticResource Cabecalho}" Tag="area" Click="OnSort" Content="ÁREA" />
                        <Button Grid.Column="3" Style="{StaticResource Cabecalho}" Tag="tempo" Click="OnSort" Content="⏱ TEMPO" />
                        <Button Grid.Column="4" Style="{StaticResource Cabecalho}" Tag="ouro" Click="OnSort" Content="OURO/H" />
                        <Button Grid.Column="5" Style="{StaticResource Cabecalho}" Tag="xp" Click="OnSort" Content="XP/H" />
                        <Button Grid.Column="6" Style="{StaticResource Cabecalho}" Tag="abates" Click="OnSort" Content="ABATES/H" />
                        <Button Grid.Column="7" Style="{StaticResource Cabecalho}" Tag="capturas" Click="OnSort" Content="CAPTURAS" />
                        <Button Grid.Column="8" Style="{StaticResource Cabecalho}" Tag="shiny" Click="OnSort" Content="✨ V / C" />
                        <Button Grid.Column="9" Style="{StaticResource Cabecalho}" Tag="melhor" Click="OnSort" Content="MELHOR CAPTURA" />
                        <Button Grid.Column="10" Style="{StaticResource Cabecalho}" Tag="ultima" Click="OnSort" Content="ÚLTIMA CAPTURA" />
                        <Button Grid.Column="11" Style="{StaticResource Cabecalho}" Tag="status" Click="OnSort" Content="STATUS" />
                    </Grid>
                    <ItemsControl x:Name="Linhas">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LinhaBt}" Tag="{Binding Slot}" Click="OnOpenAccount">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="c0" /><ColumnDefinition SharedSizeGroup="c1" /><ColumnDefinition SharedSizeGroup="c2" />
                                            <ColumnDefinition SharedSizeGroup="c3" /><ColumnDefinition SharedSizeGroup="c4" /><ColumnDefinition SharedSizeGroup="c5" />
                                            <ColumnDefinition SharedSizeGroup="c6" /><ColumnDefinition SharedSizeGroup="c7" /><ColumnDefinition SharedSizeGroup="c8" />
                                            <ColumnDefinition SharedSizeGroup="c9" /><ColumnDefinition SharedSizeGroup="c10" /><ColumnDefinition Width="*" MinWidth="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{Binding Cor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Conta}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Cel}" Text="{Binding Hunt}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Cel}" Text="{Binding Area}" Foreground="{Binding AreaCor}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Cel}" Text="{Binding Tempo}" Foreground="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource Cel}" Text="{Binding OuroH}" Foreground="{StaticResource Good}" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource Cel}" Text="{Binding XpH}" Foreground="#4C8DFF" />
                                        <TextBlock Grid.Column="6" Style="{StaticResource Cel}" Text="{Binding AbatesH}" />
                                        <TextBlock Grid.Column="7" Style="{StaticResource Cel}" Text="{Binding Capturas}" />
                                        <TextBlock Grid.Column="8" Style="{StaticResource Cel}" Text="{Binding Shiny}" Foreground="#F26DB0" />
                                        <TextBlock Grid.Column="9" Style="{StaticResource Cel}" Text="{Binding Melhor}" Foreground="#7FB6FF" />
                                        <TextBlock Grid.Column="10" Style="{StaticResource Cel}" Text="{Binding Ultima}" Foreground="#C9D96B" />
                                        <TextBlock Grid.Column="11" Style="{StaticResource Cel}" Text="{Binding Status}" Foreground="{Binding StatusCor}" Margin="0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Um cartão por conta: nível, Pokémon, saldo, sessão, pokébolas, bônus, melhor hunt e drops raros -->
            <ItemsControl x:Name="Cartoes" Margin="0,0,-12,2" Tag="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CartaoBt}" Tag="{Binding Slot}" Click="OnOpenAccount" Margin="0,0,12,12">
                            <StackPanel>
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding Cor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Conta}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusCor}" FontSize="11.5" TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding TemNivel, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Nivel}" FontSize="12.5" FontWeight="SemiBold" />
                                    <ProgressBar Style="{StaticResource Barra}" Value="{Binding NivelPct, Mode=OneWay}" Foreground="{Binding Cor}" Margin="0,5,0,4" />
                                    <TextBlock Text="{Binding NivelDetalhe}" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Linhas}" Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition SharedSizeGroup="rot" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rotulo}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,12,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Valor}" Foreground="{Binding Cor}" FontSize="12" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Quem está na Outland mostra os drops -->
            <Border x:Name="CartaoOutland" Background="{StaticResource CardBg}" BorderBrush="#5B4B8A" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secao}" Foreground="#B58CFF" Text="🌌 DROPS DA OUTLAND · CONTAS QUE FARMAM (OU FARMARAM) LÁ NESTA SESSÃO" />
                    <ItemsControl x:Name="ListaOutland">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,14,0" MinWidth="230">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Cor}" Margin="0,3,8,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Conta}" FontWeight="SemiBold" FontSize="12.5" />
                                            <TextBlock Text="{Binding Local}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Itens}" TextWrapping="Wrap" FontSize="12.5" Foreground="#E6E6EA" LineHeight="20" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Capturas e shinies -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" MinHeight="150">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secao}" Text="ÚLTIMAS CAPTURAS · TODAS AS CONTAS" />
                        <TextBlock x:Name="SemCapturas" Text="Nenhuma captura nesta sessão ainda." Foreground="{StaticResource Muted}" FontSize="12" />
                        <ItemsControl x:Name="Capturas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Hora}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="12,0,0,0" />
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{Binding Cor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Nome}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,12,0" />
                                        <TextBlock Text="{Binding Detalhe}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" MinHeight="150">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secao}" Text="✨ APARIÇÕES DE SHINY" />
                        <TextBlock x:Name="SemShinies" Text="Nenhum shiny apareceu nesta sessão." Foreground="{StaticResource Muted}" FontSize="12" />
                        <ItemsControl x:Name="Shinies">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Hora}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="12,0,0,0" />
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Fill="{Binding Cor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Resultado}" Foreground="{Binding ResultadoCor}" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
