<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ThoseIdles</AssemblyName>
    <RootNamespace>ThoseIdles</RootNamespace>
    <Version>1.0.10</Version>
    <Product>ThoseIdles</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ícone do .exe (Explorer, atalhos, barra de tarefas). Gerado por tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\pokeball.ico</ApplicationIcon>

    <!-- Memória do processo anfitrião: GC de estação sem thread de GC em background.
         A UI é leve; a coleta concorrente só acrescenta uma thread e reservas extras. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>

    <!-- Single-file SEM compressão: comprimido, o .NET descompacta os assemblies em memória privada
         (medido: ~98 MB no processo do app contra ~35 MB). Sem compressão eles são mapeados do disco. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- WebView2Loader.dll vai DENTRO do exe: quem baixa só o .exe da Release consegue abrir. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ícone também como recurso WPF (janela e barra superior). -->
    <Resource Include="Assets\pokeball.ico" />
    <!-- Exportar shinies: o MESMO script da extensão do Chrome (extensions/shiny-export). -->
    <EmbeddedResource Include="..\..\extensions\shiny-export\shiny-export.js" LogicalName="ShinyExport.js" />
    <EmbeddedResource Include="..\..\extensions\rmt-alert\rmt-alert.js" LogicalName="RmtAlert.js" />
    <EmbeddedResource Include="..\..\extensions\shared\ti-ui.js" LogicalName="TiUi.js" />
    <EmbeddedResource Include="..\..\extensions\sniper\sniper.js" LogicalName="Sniper.js" />
    <EmbeddedResource Include="..\..\extensions\price-calc\price-calc.js" LogicalName="PriceCalc.js" />
    <None Remove="Assets\pokeball.preview.png" />
  </ItemGroup>

</Project>
