<Window x:Class="ThoseIdles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:ThoseIdles.Views"
        xmlns:vm="clr-namespace:ThoseIdles.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="ThoseIdles" Icon="pack://application:,,,/Assets/pokeball.ico" Width="1400" Height="900" MinWidth="800" MinHeight="500"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <!-- Barra superior -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,0">
            <DockPanel Height="38">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/pokeball.ico" Width="18" Height="18" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Text="ThoseIdles" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Background="{StaticResource Border}" Margin="14,0" />
                    <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Background="{StaticResource Border}" Margin="14,0" />
                    <TextBlock Text="{Binding MemoryText}" FontSize="12.5" VerticalAlignment="Center" ToolTip="{Binding MemoryTooltip}"
                               ToolTipService.ShowDuration="60000" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BarButton}" Content="{Binding LayoutButtonText}" Command="{Binding ToggleLayoutCommand}"
                            ToolTip="Alterna entre a grade 2x2 e uma conta em destaque. As outras continuam rodando como miniaturas." />
                    <Button Style="{StaticResource BarButton}" Content="Abrir todas" Command="{Binding StartAllCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="Fechar todas" Command="{Binding CloseAllCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="Reiniciar todas" Command="{Binding RestartAllCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="14" Width="32" Height="28" Margin="4,0,0,0"
                            Command="{Binding ToggleSettingsCommand}" ToolTip="Configurações e diagnóstico" />
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- Configurações (ocupa espaço de layout; nunca é sobreposta aos jogos) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Padding="14,8" Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <WrapPanel>
                    <CheckBox Content="Abrir as 4 contas ao iniciar" IsChecked="{Binding StartAllOnLaunch}" />
                    <CheckBox Content="Monitorar conexão do jogo (WebSocket)" IsChecked="{Binding MonitorGameConnection}"
                              ToolTip="Só observa abertura/fechamento do WebSocket do jogo via DevTools Protocol, para o indicador 'Conectada'. Não lê nem altera mensagens." />
                    <CheckBox Content="Miniaturas com zoom reduzido" IsChecked="{Binding ScaleThumbnails}" />
                    <CheckBox Content="Memória baixa nas miniaturas (experimental)" IsChecked="{Binding LowMemoryTargetForThumbnails}"
                              ToolTip="Pede ao WebView2 MemoryUsageTargetLevel=Low nas miniaturas. Não pausa o jogo, mas pode descartar caches e deixar a volta ao foco mais lenta. Meça antes de manter ligado." />
                    <CheckBox Content="Interface por software" IsChecked="{Binding SoftwareRenderingForUi}"
                              ToolTip="A interface WPF não carrega Direct3D (economiza memória do processo do app). Os jogos continuam com GPU. Vale na próxima abertura." />
                    <CheckBox Content="Gravar CSV de memória" IsChecked="{Binding RecordBenchmarkCsv}" />
                    <CheckBox Content="Modo desenvolvedor (DevTools)" IsChecked="{Binding DeveloperMode}" />
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Zoom de todas as contas:" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                               ToolTip="Ajusta as 4 de uma vez. Para uma conta só: Ctrl + roda do mouse na página dela." />
                    <Slider Width="140" Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Margin="6,0"
                            Value="{Binding GridZoomPercent}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GridZoomPercent, StringFormat={}{0:0}%}" FontSize="12" Width="40" VerticalAlignment="Center" />
                    <TextBlock Text="Medir memória a cada:" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <ComboBox ItemsSource="{Binding PollIntervals}" SelectedItem="{Binding MemoryPollSeconds}" Width="60" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="s" FontSize="12" VerticalAlignment="Center" Margin="4,0,16,0" />
                    <Button Style="{StaticResource BarButton}" Content="Exportar snapshot de memória (CSV)" Command="{Binding ExportSnapshotCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="Abrir pasta de logs" Command="{Binding OpenLogsCommand}" />
                    <Button Style="{StaticResource BarButton}" Content="Abrir pasta de dados" Command="{Binding OpenDataCommand}" />
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Extensão /hunt for PokeIdle (guia de hunts, só leitura):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Content="Usar nas contas" IsChecked="{Binding EnableHuntExtension}" VerticalAlignment="Center"
                              ToolTip="Liga o suporte a extensões do WebView2 e carrega a /hunt nos perfis. Reabre as contas abertas (continuam logadas). Use o botão de lupa em cada conta para ligar/desligar só nela." />
                    <Button Style="{StaticResource BarButton}" Content="Baixar / atualizar" Command="{Binding DownloadHuntCommand}"
                            ToolTip="Baixa a versão mais recente da Chrome Web Store (servidor de atualização do Google) e valida o manifesto antes de instalar." />
                    <CheckBox Content="Atualizar automaticamente" IsChecked="{Binding AutoUpdateHuntExtension}" VerticalAlignment="Center" Margin="8,3,18,3"
                              ToolTip="Consulta a loja ao abrir o app e a cada 12 h. Versão nova é baixada, conferida (SHA-256 + manifesto) e usada quando cada conta recarregar ou reabrir — nenhuma conta é recarregada sozinha." />
                    <TextBlock Text="{Binding HuntStatusText}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap">
                    <Run Text="WebView2 Runtime:" /> <Run Text="{Binding RuntimeVersion, Mode=OneWay}" />
                    <Run Text="  ·  Dados:" /> <Run Text="{Binding DataFolder, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Avisos curtos -->
        <Border DockPanel.Dock="Top" Background="#1E2433" Padding="12,4" Visibility="{Binding Notice, Converter={StaticResource StrToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnDismissNotice" />
                <TextBlock Text="{Binding Notice}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- As quatro contas: sempre presentes e visíveis; o modo só muda a disposição -->
        <v:SessionLayoutPanel Margin="4" IsFocusMode="{Binding IsFocusMode}" FocusedIndex="{Binding FocusedIndex}"
                              RowSplit="{Binding RowSplit}" TopSplit="{Binding TopSplit}" BottomSplit="{Binding BottomSplit}"
                              FocusSplit="{Binding FocusSplit}" SplitCommitted="OnSplitCommitted">
            <v:AccountPanel DataContext="{Binding Account1}" />
            <v:AccountPanel DataContext="{Binding Account2}" />
            <v:AccountPanel DataContext="{Binding Account3}" />
            <v:AccountPanel DataContext="{Binding Account4}" />
        </v:SessionLayoutPanel>
    </DockPanel>
</Window>
