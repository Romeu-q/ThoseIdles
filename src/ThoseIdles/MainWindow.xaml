<Window x:Class="ThoseIdles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:ThoseIdles.Views"
        xmlns:vm="clr-namespace:ThoseIdles.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="ThoseIdles" Icon="pack://application:,,,/Assets/pokeball.ico" Width="1400" Height="900" MinWidth="800" MinHeight="500"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <!-- Barra superior: estado à esquerda, ações à direita -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel Height="46">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/pokeball.ico" Width="20" Height="20" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ThoseIdles" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SummaryText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" ToolTip="{Binding MemoryTooltip}" ToolTipService.ShowDuration="60000">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE964;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding MemoryText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Quantas contas usar -->
                    <TextBlock Text="Quantas contas?" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="#24242C" CornerRadius="6" Padding="2" Margin="0,0,12,0"
                            ToolTip="Quantas contas usar. As que saem são fechadas, mas o login fica salvo: ao voltar, a conta abre logada.">
                        <ItemsControl ItemsSource="{Binding AccountCountChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="contas" Content="{Binding Count}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Button Style="{StaticResource BarButton}" Command="{Binding ToggleLayoutCommand}" IsEnabled="{Binding CanToggleLayout}"
                            ToolTip="Alterna entre a grade e uma conta em destaque. As outras continuam rodando como miniaturas.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LayoutButtonText}" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="8,0" />
                    <Button Style="{StaticResource BarButton}" Command="{Binding ShowWelcomeCommand}" ToolTip="Mostra de novo o passo a passo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Ajuda" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartAllCommand}" ToolTip="Abre todas as contas que estão fechadas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Abrir todas" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BarButton}" Command="{Binding CloseAllCommand}" ToolTip="Fecha todas as contas (o login fica salvo)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Fechar todas" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Background="{StaticResource Border}" Margin="8,0" />
                    <Button Style="{StaticResource BarButton}" Command="{Binding ToggleSettingsCommand}" ToolTip="Configurações e diagnóstico">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Configurações" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- Configurações em cartões (ocupa espaço de layout; nunca é sobreposta aos jogos) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}">
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Padding="14,12,4,2">
                <StackPanel>
                <DockPanel Margin="2,0,10,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BarButton}" Content="Fechar configurações" Command="{Binding ToggleSettingsCommand}" />
                    <TextBlock Text="Configurações — o básico" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <WrapPanel>
                    <!-- Geral -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Geral" />
                            <CheckBox Content="Abrir as contas ao iniciar" IsChecked="{Binding StartAllOnLaunch}"
                                      Tag="Quando o app abre, já entra em todas as contas escolhidas." />
                            <CheckBox Content="Avisar quando sair versão nova" IsChecked="{Binding CheckAppUpdates}"
                                      Tag="Mostra uma faixa com link para baixar. Não instala nada sozinho." />
                            <TextBlock Text="Zoom de todas as contas" FontSize="12.5" Margin="0,8,0,2" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GridZoomPercent, StringFormat={}{0:0}%}" FontSize="12" Width="40"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                                <Slider Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding GridZoomPercent}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Para uma conta só: botão &quot;Mais&quot; no topo dela → zoom." />
                        </StackPanel>
                    </Border>

                    <!-- Ferramentas no jogo -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Ferramentas no jogo" />
                            <CheckBox Content="Exportar shinies para TXT" IsChecked="{Binding EnableShinyExport}"
                                      Tag="Botão &quot;Exportar TXT&quot; na página Shinies: espécie, potência, qualidade, IVs e valor no RMT." />
                            <CheckBox Content="Alerta de RMT" IsChecked="{Binding EnableRmtAlert}"
                                      Tag="Botão &quot;🔔 RMT&quot; no canto do jogo: avisa anúncios em Gemas que batem com as suas regras. Só avisa, nunca compra." />
                            <CheckBox Content="Calculadora de preço" IsChecked="{Binding EnablePriceCalc}"
                                      Tag="Botão &quot;💰 Preço&quot; no jogo: quanto vale o seu Pokémon no RMT (nota 3,5 ou mais) e em ouro, comparando com o mercado." />
                            <CheckBox Content="Sniper do mercado (compra automática)" IsChecked="{Binding EnableSniper}"
                                      Tag="Botão &quot;🎯 Sniper&quot; no jogo: compra sozinho o que bater com as suas regras (preço máximo e limite de compras obrigatórios). Sempre abre desligado." />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Depois de mudar, use &quot;Mais → Reiniciar esta conta&quot; para valer." />
                        </StackPanel>
                    </Border>

                    <!-- Twitch -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Lives da Twitch (bônus de XP)" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Abra a tela &quot;Twitch&quot; dentro do jogo e clique num canal: a live abre escondida, embaixo da conta." />
                            <CheckBox Content="Abrir sem som" IsChecked="{Binding LiveMutedByDefault}" />
                            <CheckBox Content="Qualidade mais baixa" IsChecked="{Binding LiveLowestQuality}"
                                      Tag="Gasta menos internet e computador." />
                            <CheckBox Content="Reabrir as lives junto com a conta" IsChecked="{Binding ReopenLives}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Avançado: escondido até o usuário pedir -->
                <CheckBox Content="Mostrar opções avançadas" IsChecked="{Binding ShowAdvanced}" Margin="2,2,0,10"
                          Tag="Desempenho, extensão /hunt, diagnóstico. Não precisa mexer para jogar." />
                <WrapPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Lives da Twitch — avançado" />
                            <CheckBox Content="Economizar memória com a live escondida" IsChecked="{Binding LiveHiddenLowMemory}" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="Recarregar lives a cada" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock DockPanel.Dock="Right" Text="min" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <ComboBox ItemsSource="{Binding LiveReloadOptions}" SelectedItem="{Binding LiveReloadMinutes}" Width="64" HorizontalAlignment="Right" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="O chat acumula memória; recarregar libera. 0 = nunca." Margin="0,2,0,6" />
                            <Button Style="{StaticResource BarButton}" Content="Recarregar lives agora" Command="{Binding ReloadLivesNowCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,4" />
                            <CheckBox Content="Modo leve (experimental)" IsChecked="{Binding LiveLightMode}"
                                      Tag="Só o player e o chat, sem o resto do site. Confira se o chat mostra você logado." />
                        </StackPanel>
                    </Border>

                    <!-- /hunt -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Extensão /hunt for PokeIdle" />
                            <TextBlock Style="{StaticResource Hint}" Text="Guia de hunts dentro do jogo (só leitura)." Margin="0,0,0,6" />
                            <CheckBox Content="Usar nas contas" IsChecked="{Binding EnableHuntExtension}"
                                      Tag="Reabre as contas abertas (continuam logadas). A lupa em cada conta liga/desliga só nela." />
                            <CheckBox Content="Atualizar automaticamente" IsChecked="{Binding AutoUpdateHuntExtension}"
                                      Tag="Confere a loja ao abrir e a cada 12 h." />
                            <DockPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource BarButton}" Content="Baixar / atualizar" Command="{Binding DownloadHuntCommand}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding HuntStatusText}" Style="{StaticResource Hint}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Desempenho -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Desempenho" />
                            <CheckBox Content="Miniaturas com zoom reduzido" IsChecked="{Binding ScaleThumbnails}"
                                      Tag="No modo destaque, as contas pequenas mostram a página inteira." />
                            <CheckBox Content="Memória baixa nas miniaturas (experimental)" IsChecked="{Binding LowMemoryTargetForThumbnails}"
                                      Tag="Não pausa o jogo, mas a volta ao destaque pode ficar mais lenta." />
                            <CheckBox Content="Interface por software" IsChecked="{Binding SoftwareRenderingForUi}"
                                      Tag="Economiza memória do app; os jogos continuam com GPU. Vale na próxima abertura." />
                            <CheckBox Content="Indicador de conexão do jogo" IsChecked="{Binding MonitorGameConnection}"
                                      Tag="Mostra &quot;Conectada&quot; no topo de cada conta." />
                        </StackPanel>
                    </Border>

                    <!-- Diagnóstico -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Diagnóstico" />
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Medir memória a cada" FontSize="12.5" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="s" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <ComboBox ItemsSource="{Binding PollIntervals}" SelectedItem="{Binding MemoryPollSeconds}" Width="64" HorizontalAlignment="Right" />
                            </DockPanel>
                            <CheckBox Content="Gravar CSV de memória" IsChecked="{Binding RecordBenchmarkCsv}" />
                            <CheckBox Content="Modo desenvolvedor (DevTools)" IsChecked="{Binding DeveloperMode}" />
                            <WrapPanel Margin="0,6,0,6">
                                <Button Style="{StaticResource BarButton}" Content="Snapshot (CSV)" Command="{Binding ExportSnapshotCommand}" Margin="0,0,6,6" />
                                <Button Style="{StaticResource BarButton}" Content="Pasta de logs" Command="{Binding OpenLogsCommand}" Margin="0,0,6,6" />
                                <Button Style="{StaticResource BarButton}" Content="Pasta de dados" Command="{Binding OpenDataCommand}" Margin="0,0,6,6" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="WebView2" /> <Run Text="{Binding RuntimeVersion, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Como usar (primeira vez; volta pelo botão "Ajuda") -->
        <Border DockPanel.Dock="Top" Background="#221D38" BorderBrush="#3F3570" BorderThickness="0,0,0,1" Padding="16,12"
                Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Entendi" Command="{Binding DismissWelcomeCommand}"
                        VerticalAlignment="Center" Padding="18,6" />
                <StackPanel>
                    <TextBlock Text="Como usar — é só 3 passos" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Border Background="#2C2547" CornerRadius="6" Padding="10,6" Margin="0,0,8,4">
                            <TextBlock FontSize="12.5"><Run Text="1." FontWeight="Bold" /> Lá em cima, em <Run Text="Quantas contas?" FontWeight="SemiBold" />, clique no número.</TextBlock>
                        </Border>
                        <Border Background="#2C2547" CornerRadius="6" Padding="10,6" Margin="0,0,8,4">
                            <TextBlock FontSize="12.5"><Run Text="2." FontWeight="Bold" /> Clique no botão roxo <Run Text="Abrir todas" FontWeight="SemiBold" />.</TextBlock>
                        </Border>
                        <Border Background="#2C2547" CornerRadius="6" Padding="10,6" Margin="0,0,8,4">
                            <TextBlock FontSize="12.5"><Run Text="3." FontWeight="Bold" /> Entre no jogo em cada quadro. O login fica salvo: da próxima vez já abre logado.</TextBlock>
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                               Text="Algo travou? Clique em &quot;Recarregar&quot; no topo da conta. Outras opções ficam em &quot;Mais&quot;." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Versão nova no GitHub -->
        <Border DockPanel.Dock="Top" Background="#1F3A2A" BorderBrush="#2F6B45" BorderThickness="0,0,0,1" Padding="14,6"
                Visibility="{Binding AppUpdateText, Converter={StaticResource StrToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding DismissAppUpdateCommand}"
                        ToolTip="Não avisar mais sobre esta versão" />
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Baixar" Command="{Binding OpenAppUpdateCommand}"
                        ToolTip="Abre a página da Release no navegador. Feche o app e troque o .exe pelo novo: as contas continuam logadas." />
                <TextBlock DockPanel.Dock="Left" Text="&#xE896;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource Good}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding AppUpdateText}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Avisos curtos -->
        <Border DockPanel.Dock="Top" Background="#1E2433" BorderBrush="#2F3A55" BorderThickness="0,0,0,1" Padding="14,6"
                Visibility="{Binding Notice, Converter={StaticResource StrToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnDismissNotice" ToolTip="Fechar aviso" />
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource Icons}" Foreground="#7FA2FF"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Notice}" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- As contas: sempre presentes e visíveis; o modo só muda a disposição -->
        <v:SessionLayoutPanel Margin="6" IsFocusMode="{Binding IsFocusMode}" FocusedIndex="{Binding FocusedIndex}" VisibleCount="{Binding VisibleAccounts}"
                              RowSplit="{Binding RowSplit}" TopSplit="{Binding TopSplit}" BottomSplit="{Binding BottomSplit}"
                              FocusSplit="{Binding FocusSplit}" SplitCommitted="OnSplitCommitted">
            <v:AccountPanel DataContext="{Binding Account1}" />
            <v:AccountPanel DataContext="{Binding Account2}" />
            <v:AccountPanel DataContext="{Binding Account3}" />
            <v:AccountPanel DataContext="{Binding Account4}" />
        </v:SessionLayoutPanel>
    </DockPanel>
</Window>
